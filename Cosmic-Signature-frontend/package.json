{
  "name": "cosmic-signature-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <21 || >=22.13 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:testing": "tsx scripts/harness/cli.ts up",
    "harness": "tsx scripts/harness/cli.ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:fuzz": "jest --runInBand --testPathPatterns=[.]fuzz[.]test[.]tsx?$",
    "pretest:coverage": "npm run test:wallet-sdk",
    "test:coverage": "jest --coverage",
    "test:seo": "jest --runInBand --runTestsByPath \"app/[locale]/(app)/__tests__/seo-policy.test.ts\" \"app/[locale]/(app)/__tests__/seo-summaries.test.tsx\" \"app/[locale]/(app)/__tests__/sitewide-metadata.test.ts\" \"app/[locale]/(app)/__tests__/jsonld-pages.test.tsx\" \"app/[locale]/(app)/__tests__/sitemap.test.ts\" lib/__tests__/og.test.tsx lib/og/__tests__/og-localization.test.ts utils/__tests__/seo.test.ts utils/__tests__/jsonLd.test.ts utils/__tests__/jsonLd.test.tsx utils/__tests__/indexNow.test.ts content/__tests__/learn.test.ts public/__tests__/llms.test.ts && playwright test e2e/seo-raw-html.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:harness": "playwright test --project=harness",
    "test:e2e:locales": "HARNESS_E2E=0 playwright test e2e/*-smoke.spec.ts e2e/*-site-qa.desktop.spec.ts e2e/zh-*.spec.ts e2e/a11y.spec.ts e2e/proxy.spec.ts e2e/landing.spec.ts e2e/wallet.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "bundle:budget": "tsx scripts/bundle-budget.ts",
    "contracts:generate": "wagmi generate",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "deps:audit": "tsx scripts/dependency-audit.ts",
    "audit:protocol-facts": "tsx scripts/audit-protocol-facts.ts",
    "indexnow:submit": "tsx scripts/indexnow-submit.ts",
    "i18n:parity": "tsx scripts/i18n-parity.ts",
    "i18n:strict": "tsx scripts/i18n-parity.ts --strict",
    "i18n:conventions": "tsx scripts/i18n-conventions.ts",
    "i18n:check": "npm run i18n:strict && npm run i18n:conventions && npm run terminology:check && npm run lexicon:scan",
    "i18n:derive": "tsx scripts/i18n-derive-variant.ts",
    "i18n:scaffold": "tsx scripts/i18n-scaffold-locale.ts",
    "terminology:check": "tsx scripts/terminology-consistency.ts",
    "lexicon:scan": "tsx scripts/lexicon-scan.ts",
    "white-paper:pdf": "tsx scripts/generate-white-paper-pdf.ts",
    "llms:build": "tsx scripts/generate-llms-docs.ts",
    "og:fonts": "tsx scripts/build-og-fonts.ts",
    "seo:share-check": "tsx scripts/share-metadata-check.ts",
    "brand:icons": "tsx scripts/build-brand-icons.ts",
    "postinstall": "node scripts/apply-wallet-patches.mjs",
    "test:wallet-sdk": "node --test scripts/tests/wallet-sdks.mjs scripts/tests/wallet-patches.mjs"
  },
  "dependencies": {
    "@babel/runtime": "^8.1.2",
    "@coinbase/wallet-sdk": "^4.4.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@sentry/nextjs": "^11.15.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.108.1",
    "@types/react-dom": "19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.76.0",
    "next": "^16.4.3",
    "next-intl": "^4.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.2.1",
    "viem": "^2.58.2",
    "wagmi": "^3.7.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.1.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@formatjs/icu-messageformat-parser": "^3.5.17",
    "@formatjs/intl-localematcher": "^0.10.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "21.1.7",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@wagmi/cli": "^2.10.1",
    "babel-jest": "^30.5.2",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "4.10.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "31.0.1",
    "lint-staged": "^17.6.1",
    "opencc-js": "^1.4.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "proper-lockfile": "4.1.2",
    "subset-font": "^2.9.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@noble/hashes": "^1.8.0",
    "axios": "$axios",
    "@coinbase/cdp-sdk": {
      ".": "1.51.2",
      "abitype": "1.3.0",
      "zod": "$zod"
    },
    "@rainbow-me/rainbowkit": {
      "wagmi": "^3.6.15"
    },
    "@reown/appkit-wallet@1.8.19": {
      "zod": "$zod"
    },
    "glob@>=9.0.0 <14.0.2": "^14.0.6",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@10.9.8"
}
